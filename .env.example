# Copie este arquivo para .env (ou configure na Vercel em Settings -> Environment Variables)

# 1. Supabase (Banco de Dados na Nuvem)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-do-supabase

# 2. TMDB API Key (Busca automática de Pôsteres e Data de Estreia)
VITE_TMDB_API_KEY=sua-chave-api-v3-do-tmdb

# 3. PIN de Segurança para liberar escrita uma única vez por dispositivo (Padrão: 1234)
VITE_APP_PIN=1234
